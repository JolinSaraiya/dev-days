---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categories = [...new Map(
  games
    .filter((game) => game.category)
    .map((game) => [game.category!.id, game.category!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
const publishers = [...new Map(
  games
    .filter((game) => game.publisher)
    .map((game) => [game.publisher!.id, game.publisher!]),
).values()].sort((a, b) => a.name.localeCompare(b.name));
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <div class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-6" data-testid="game-filters">
        <h2 class="mb-4 text-2xl font-medium text-slate-100">Find your next game</h2>
        <form class="space-y-5" data-testid="game-filter-form">
          <fieldset>
            <legend class="mb-3 text-sm font-medium text-slate-200">Categories</legend>
            <div class="flex flex-wrap gap-3">
              {categories.map((category) => (
                <label class="flex cursor-pointer items-center gap-2 rounded-lg border border-slate-600 px-3 py-2 text-sm text-slate-300 transition-colors hover:border-blue-400 focus-within:ring-2 focus-within:ring-blue-500">
                  <input
                    type="checkbox"
                    name="categories"
                    value={category.id}
                    class="h-4 w-4 accent-blue-500 focus:ring-2 focus:ring-blue-500"
                    data-testid={`category-filter-${category.id}`}
                  />
                  <span>{category.name}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="flex flex-col gap-2">
            <label for="publisher-filter" class="text-sm font-medium text-slate-200">Publisher</label>
            <select
              id="publisher-filter"
              name="publisher"
              class="max-w-md rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="publisher-filter"
            >
              <option value="">All publishers</option>
              {publishers.map((publisher) => <option value={publisher.id}>{publisher.name}</option>)}
            </select>
          </div>

          <div class="flex flex-wrap items-center gap-3">
            <button
              type="submit"
              class="rounded-lg bg-blue-600 px-4 py-2 font-medium text-white transition-colors hover:bg-blue-500 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="apply-filters"
            >
              Apply filters
            </button>
            <button
              type="reset"
              class="rounded-lg border border-slate-600 px-4 py-2 font-medium text-slate-200 transition-colors hover:bg-slate-700 focus:ring-2 focus:ring-blue-500 focus:outline-none"
              data-testid="clear-filters"
            >
              Clear filters
            </button>
            <span class="text-sm text-slate-400" data-testid="filter-results-count" aria-live="polite">
              Showing {games.length} {games.length === 1 ? 'game' : 'games'}
            </span>
          </div>
        </form>
      </div>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
          {games.map((game) => <GameCard game={game} />)}
        </div>
      )}
      <div class="hidden" data-testid="filtered-empty-state">
        <EmptyState text="No games match those filters." />
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-testid="game-filter-form"]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-testid="game-card"]')];
  const grid = document.querySelector<HTMLElement>('[data-testid="games-grid"]');
  const emptyState = document.querySelector<HTMLElement>('[data-testid="filtered-empty-state"]');
  const count = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');

  if (form && cards.length > 0 && grid && emptyState && count) {
    const categoryInputs = [...form.querySelectorAll<HTMLInputElement>('input[name="categories"]')];
    const publisherInput = form.querySelector<HTMLSelectElement>('select[name="publisher"]');

    const updateUrl = (categories: string[], publisher: string): void => {
      const url = new URL(window.location.href);
      url.searchParams.delete('categories');
      categories.forEach((category) => url.searchParams.append('categories', category));
      if (publisher) {
        url.searchParams.set('publisher', publisher);
      } else {
        url.searchParams.delete('publisher');
      }
      window.history.replaceState({}, '', url);
    };

    const applyFilters = (): void => {
      const selectedCategories = categoryInputs.filter((input) => input.checked).map((input) => input.value);
      const selectedPublisher = publisherInput?.value ?? '';
      let visibleCount = 0;

      cards.forEach((card) => {
        const categoryMatches =
          selectedCategories.length === 0 ||
          selectedCategories.includes(card.dataset.gameCategoryId ?? '');
        const publisherMatches =
          selectedPublisher === '' || card.dataset.gamePublisherId === selectedPublisher;
        const visible = categoryMatches && publisherMatches;
        card.classList.toggle('hidden', !visible);
        if (visible) visibleCount += 1;
      });

      grid.classList.toggle('hidden', visibleCount === 0);
      emptyState.classList.toggle('hidden', visibleCount !== 0);
      count.textContent = `Showing ${visibleCount} ${visibleCount === 1 ? 'game' : 'games'}`;
      updateUrl(selectedCategories, selectedPublisher);
    };

    const params = new URLSearchParams(window.location.search);
    const selectedCategories = params.getAll('categories');
    categoryInputs.forEach((input) => {
      input.checked = selectedCategories.includes(input.value);
    });
    if (publisherInput) publisherInput.value = params.get('publisher') ?? '';

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      applyFilters();
    });
    form.addEventListener('reset', () => {
      window.setTimeout(applyFilters, 0);
    });
    applyFilters();
  }
</script>
